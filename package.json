{
  "name": "tray-metrics",
  "productName": "TrayMetrics",
  "version": "1.0.0",
  "private": true,
  "description": "Windows tray icon showing one live system metric at a time",
  "author": "TrayMetrics",
  "license": "MIT",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "probe": "node src/probe.js",
    "selftest": "electron src/selftest.js",
    "shot": "electron src/shot.js",
    "footcheck": "electron src/footcheck.js",
    "icons": "electron src/preview.js",
    "trayshot": "electron src/trayshot.js",
    "trayascii": "electron src/trayascii.js",
    "ink": "electron src/inkcheck.js",
    "dist": "electron-builder --win --x64",
    "dist:nsis": "electron-builder --win --x64 --c.win.target=nsis",
    "dist:portable": "electron-builder --win --x64 --c.win.target=portable"
  },
  "devDependencies": {
    "electron": "45.2.3",
    "electron-builder": "^25.1.8"
  }
}